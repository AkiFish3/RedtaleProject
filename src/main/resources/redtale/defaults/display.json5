{
  // 显示口径（D20 / Q-023 默认 A）。**服务端配置，全服生效**：
  // 改完 `/redtale reload` 即刻生效，不用重启、不用换 jar、不用装客户端模组。
  //
  // 三条开关都只影响「写了什么」，不影响「打出多少」——
  // 数值一律出自与实打同一个 settle()，关掉 DPS 不会让伤害变。

  // 武器 tooltip 追加一行 DPS（= 单次伤害 × 次/秒）。默认关（D20：Aki 要的是单次伤害）。
  show_dps: false,

  // 追加一行属性明细：逐条列出这件东西在 ATTRIBUTE_MODIFIERS 里给了什么
  // （基底 + 宝石 + 词条各是一条 modifier，所以这里能看到来源拆分）。默认关。
  show_attribute_breakdown: false,

  // DPS 行标注的「假想目标」。v1 只用于标注，不做目标护甲/抗性推算
  // （那要跟着目标实体走，属于 M6 之后的事）。合法形态：含 `:`、无空白、无大写。
  assume_target: 'minecraft:zombie',
}
